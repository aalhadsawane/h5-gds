# EditorConfig for h5gds

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# configuration for C++ files
[*.{cpp,hpp,cu,cuh}]
indent_style = space
indent_size = 2

# configuration for scripts
[*.sh]
indent_style = tab
tab_width = 4

# configuration for markdown
[*.md]
indent_style = space
indent_size = 2

# configuration for CMake
[CMakeLists.txt]
indent_style = space
indent_size = 2
[*.cmake]
indent_style = space
indent_size = 2
