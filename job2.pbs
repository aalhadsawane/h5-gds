#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=jh250079
#PBS -j oe
#PBS -N bingds_sweep

# ============================================
# BENCHMARK CONFIGURATION
# ============================================
# Particle counts (file sizes)
NUM_VALUES=(64000000)

# I/O methods to test
IO_METHODS=(cufile direct posix)

ELAPSE_MAX=120s

# ============================================
# ENVIRONMENT SETUP
# ============================================
module purge
module load cuda
module unload nvidia

echo "=== Loaded Modules ==="
module list
echo ""

# Set cuFile configuration for GDS
export CUFILE_ENV_PATH_JSON=${PBS_O_WORKDIR}/cufile.json

echo "=== Environment Configuration ==="
echo "CUDA_HOME: $CUDA_HOME"
echo "CUFILE_ENV_PATH_JSON: $CUFILE_ENV_PATH_JSON"
echo ""

# Start timestamp
echo "=== Job Start: $(date) ==="
echo ""

# ============================================
# GPU CONFIGURATION (Fixed at GPU 0)
# ============================================
GPU_ID=0
export CUDA_VISIBLE_DEVICES=$GPU_ID

echo "=== Using GPU $GPU_ID ==="

# Get GPU PCIe bus ID and NUMA node
BUS_ID=$(nvidia-smi --query-gpu=pci.bus_id --format=csv,noheader | tr '[:upper:]' '[:lower:]' | sed 's/^0\{0,\}\([0-9]\{4\}\)/\1/')
NUMA_NODE=$(cat /sys/bus/pci/devices/$BUS_ID/numa_node)

echo "GPU $GPU_ID: BUS_ID=$BUS_ID, NUMA_NODE=$NUMA_NODE"

# Display GPU topology
echo "=== GPU Topology ==="
nvidia-smi topo -m
echo ""

# Run GDS health check
if [ -f "$CUDA_HOME/gds/tools/gdscheck" ]; then
    echo "=== GPUDirect Storage Health Check ==="
    numactl --cpunodebind=$NUMA_NODE --membind=$NUMA_NODE $CUDA_HOME/gds/tools/gdscheck -p
    echo ""
else
    echo "WARNING: gdscheck not found, skipping GDS verification"
fi

# ============================================
# DIRECTORY SETUP
# ============================================
ROOT="/tmp/yogesh/gpu${GPU_ID}"
TEMP="${PBS_O_WORKDIR}/temp"
DUMP="${PBS_O_WORKDIR}/results"

mkdir -p "${ROOT}"
mkdir -p "${TEMP}"
mkdir -p "${DUMP}"

# Copy executable and prepare directories
cd "${ROOT}"
cp -r ${PBS_O_WORKDIR}/bin .
mkdir -p dat log

echo "Working directory: ${ROOT}"
echo "Results will be saved to: ${DUMP}"
echo ""

# ============================================
# PARAMETER SWEEP
# ============================================
TOTAL_RUNS=$((${#NUM_VALUES[@]} * ${#IO_METHODS[@]}))
CURRENT_RUN=0

echo "=== Starting Parameter Sweep ==="
echo "Total configurations to test: ${TOTAL_RUNS}"
echo ""

# Loop over I/O methods
for METHOD in "${IO_METHODS[@]}"
do
    echo "========================================="
    echo "I/O METHOD: ${METHOD}"
    echo "========================================="
    
    # Loop over particle counts (file sizes)
    for NUM in "${NUM_VALUES[@]}"
    do
        CURRENT_RUN=$((CURRENT_RUN + 1))
        
        echo ""
        echo "--- Run ${CURRENT_RUN}/${TOTAL_RUNS} ---"
        echo "METHOD=$METHOD, NUM=$NUM"
        
        # Set the appropriate I/O flag
        case $METHOD in
            cufile)
                IO_FLAG="--cufile"
                ;;
            direct)
                IO_FLAG="--direct"
                ;;
            posix)
                IO_FLAG="--posix"
                ;;
        esac
        
        # Run benchmark with NUMA affinity
        timeout ${ELAPSE_MAX} numactl --cpunodebind=$NUMA_NODE --membind=$NUMA_NODE \
            bin/bingds \
            --num $NUM \
            $IO_FLAG
        
        EXIT_CODE=$?
        if [ $EXIT_CODE -eq 124 ]; then
            echo "WARNING: Benchmark timed out after ${ELAPSE_MAX}"
        elif [ $EXIT_CODE -ne 0 ]; then
            echo "ERROR: Benchmark failed with exit code $EXIT_CODE"
        fi
        
        # Sync results to temp directory periodically
        rsync -av log/ ${TEMP}/log/
        
    done  # NUM loop
    
    echo ""
done  # METHOD loop

# ============================================
# CLEANUP AND RESULTS
# ============================================
echo "=== Copying final results to ${DUMP}/ ==="
rsync -av log/ ${DUMP}/log/
cp log/bingds_benchmark.csv ${DUMP}/bingds_benchmark_gpu${GPU_ID}.csv

echo "=== Cleaning up scratch space ==="
rm -rf ${ROOT}
rm -rf ${TEMP}

echo ""
echo "=== Job Finish: $(date) ==="
echo "Results saved to: ${DUMP}/bingds_benchmark_gpu${GPU_ID}.csv"

# Display summary statistics
if [ -f "${DUMP}/bingds_benchmark_gpu${GPU_ID}.csv" ]; then
    echo ""
    echo "=== Benchmark Summary ==="
    echo "Total rows: $(wc -l < ${DUMP}/bingds_benchmark_gpu${GPU_ID}.csv)"
    head -1 ${DUMP}/bingds_benchmark_gpu${GPU_ID}.csv
fi

exit 0